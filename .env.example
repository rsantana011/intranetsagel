# Copie para .env e preencha somente na sua maquina.
SAGEL_DATABASE_BACKEND=postgresql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intranet_dev
POSTGRES_USER=intranet_dev
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Em branco: a aplicacao gera uma chave local em instance/secret.key.
SAGEL_SECRET_KEY=

# Cadastro por e-mail exige um servidor SMTP configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
